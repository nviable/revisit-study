{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.3/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Ontology-supported descriptions of digital media forensic techniques",
    "version": "pilot-placeholders",
    "authors": [
      "Y. Kelly Wu",
      "Saniat J. Sohrawardi",
      "Matthew Wright",
      "Ersin Uzun"
    ],
    "date": "2026-08-14",
    "description": "A Prolific survey comparing keyword-supported and ontology-supported descriptions of digital media forensic techniques. Vignette text and papers are placeholders until the final instrument is supplied.",
    "organizations": [
      "Rochester Institute of Technology",
      "ESL Global Cybersecurity Institute"
    ]
  },
  "uiConfig": {
    "contactEmail": "kellywu@mail.rit.edu",
    "helpTextPath": "ontology-technique-eval/assets/help.md",
    "logoPath": "revisitAssets/icon-defake.svg",
    "withProgressBar": true,
    "withSidebar": true,
    "sidebarWidth": 360,
    "enumerateQuestions": true,
    "responseDividers": true,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "stylesheetPath": "ontology-technique-eval/assets/style.css",
    "numSequences": 200
  },
  "studyRules": {
    "devices": {
      "allowed": [
        "desktop",
        "tablet"
      ],
      "blockedMessage": "Please complete this study on a laptop or desktop computer so the technique cards remain readable."
    },
    "display": {
      "minWidth": 900,
      "minHeight": 600,
      "blockedMessage": "Please widen your browser window so the scenario and technique cards are fully visible."
    }
  },
  "baseComponents": {
    "taskATrial": {
      "type": "react-component",
      "path": "ontology-technique-eval/assets/TaskAStimulus.tsx",
      "nextButtonLocation": "sidebar",
      "previousButton": false,
      "response": [
        {
          "id": "applies",
          "prompt": "Could this technique be applied to produce useful evidence in this scenario?",
          "location": "sidebar",
          "type": "radio",
          "options": [
            "Yes, it applies",
            "No, it does not apply",
            "Not enough information to decide"
          ]
        },
        {
          "id": "confidence",
          "prompt": "How confident are you in this judgment?",
          "secondaryText": "1 = Not at all confident. 5 = Completely confident.",
          "location": "sidebar",
          "type": "slider",
          "snap": true,
          "step": 1,
          "options": [
            {
              "label": "1",
              "value": 1
            },
            {
              "label": "2",
              "value": 2
            },
            {
              "label": "3",
              "value": 3
            },
            {
              "label": "4",
              "value": 4
            },
            {
              "label": "5",
              "value": 5
            }
          ]
        },
        {
          "id": "reliedOn",
          "prompt": "What did you rely on when deciding? Select all that apply.",
          "location": "sidebar",
          "type": "checkbox",
          "minSelections": 1,
          "withOther": true,
          "options": [
            "Technique title",
            "Keywords or structured tags",
            "Tag definitions",
            "Abstract",
            "Plain-language summary",
            "Full paper"
          ]
        },
        {
          "id": "decisionNote",
          "prompt": "Anything else you'd like to add about this decision?",
          "location": "sidebar",
          "type": "longText",
          "placeholder": "Optional",
          "required": false
        },
        {
          "id": "clickLog",
          "prompt": "Clicked elements (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        },
        {
          "id": "elementDwellTimes",
          "prompt": "Time spent on opened elements, in milliseconds (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        },
        {
          "id": "openedElements",
          "prompt": "Opened elements (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        }
      ]
    },
    "taskBTrial": {
      "type": "react-component",
      "path": "ontology-technique-eval/assets/TaskBStimulus.tsx",
      "nextButtonLocation": "sidebar",
      "previousButton": false,
      "sidebarWidth": 320,
      "response": [
        {
          "id": "chosenTechnique",
          "prompt": "Which technique is the appropriate fit for this case?",
          "location": "sidebar",
          "type": "radio",
          "options": [
            {
              "label": "Technique 1",
              "value": "1"
            },
            {
              "label": "Technique 2",
              "value": "2"
            },
            {
              "label": "Technique 3",
              "value": "3"
            },
            {
              "label": "Technique 4",
              "value": "4"
            }
          ]
        },
        {
          "id": "confidence",
          "prompt": "How confident are you in this choice?",
          "location": "sidebar",
          "type": "likert",
          "numItems": 5,
          "leftLabel": "Not at all confident",
          "rightLabel": "Completely confident"
        },
        {
          "id": "reliedOn",
          "prompt": "What did you rely on when choosing? Select all that apply.",
          "location": "sidebar",
          "type": "checkbox",
          "minSelections": 1,
          "withOther": true,
          "options": [
            "Scenario description",
            "Technique title",
            "Keywords or structured tags",
            "Tag definitions",
            "Abstract",
            "Plain-language summary",
            "Full paper",
            "Nothing beyond what was visible without opening extra sections"
          ]
        },
        {
          "id": "clickLog",
          "prompt": "Clicked elements (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        },
        {
          "id": "elementDwellTimes",
          "prompt": "Time spent on opened elements, in milliseconds (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        },
        {
          "id": "openedElements",
          "prompt": "Opened elements (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        },
        {
          "id": "techniqueOrder",
          "prompt": "Technique ids in card order (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        }
      ]
    }
