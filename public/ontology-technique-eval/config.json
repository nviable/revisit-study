    "reflection-intro": {
      "type": "markdown",
      "path": "ontology-technique-eval/assets/reflection-intro.md",
      "withSidebar": false,
      "response": [],
      "previousButton": true
    },
    "part-c": {
      "type": "questionnaire",
      "description": "Part C reflection on description formats, ontology categories, and possible applications.",
      "withSidebar": false,
      "nextButtonLocation": "belowStimulus",
      "response": [
        {
          "id": "noticedFormatDifference",
          "prompt": "In this study, technique descriptions were shown in two different ways. Did you notice a difference between how some descriptions were presented and others?",
          "location": "belowStimulus",
          "type": "radio",
          "options": [
            "Yes",
            "No",
            "Not sure"
          ]
        },
        {
          "id": "ontologyCategoryRank",
          "prompt": "The ontology tags are grouped into four categories: Modality; Forensic Task & Goal; Search & Analysis Scope; Evidentiary Features. Please rank them from the most useful to least useful when you use them for making decisions.",
          "location": "belowStimulus",
          "type": "ranking-sublist",
          "numItems": 4,
          "options": [
            "Modality",
            "Forensic Task & Goal",
            "Search & Analysis Scope",
            "Evidentiary Features"
          ]
        },
        {
          "id": "ontologyTagGaps",
          "prompt": "In scenarios where the technique description was accompanied by ontology tags, was there anything you wanted to know about a technique that the tags did not tell you, such that you needed to access additional information (i.e. abstract, summary, and full paper)?",
          "location": "belowStimulus",
          "type": "longText",
          "placeholder": "If nothing was missing, write none."
        },
        {
          "id": "formatPreference",
          "prompt": "If you were to work through more scenarios like what you just did, which would you rather have alongside each technique description?",
          "location": "belowStimulus",
          "type": "radio",
          "options": [
            {
              "label": "1 — Strongly prefer the paper's keywords",
              "value": "1"
            },
            {
              "label": "2 — Somewhat prefer the paper's keywords",
              "value": "2"
            },
            {
              "label": "3 — No preference",
              "value": "3"
            },
            {
              "label": "4 — Somewhat prefer the ontology tags",
              "value": "4"
            },
            {
              "label": "5 — Strongly prefer the ontology tags",
              "value": "5"
            }
          ]
        },
        {
          "id": "formatPreferenceWhy",
          "prompt": "Why?",
          "location": "belowStimulus",
          "type": "longText",
          "placeholder": "A sentence or two is enough."
        },
        {
          "id": "ontologyApplications",
          "prompt": "The ontology could be useful for the following applications (Rate from Strongly Disagree 1 to Strongly Agree 5)",
          "location": "belowStimulus",
          "type": "matrix-radio",
          "answerOptions": [
            {
              "label": "1 Strongly disagree",
              "value": "1"
            },
            {
              "label": "2",
              "value": "2"
            },
            {
              "label": "3",
              "value": "3"
            },
            {
              "label": "4",
              "value": "4"
            },
            {
              "label": "5 Strongly agree",
              "value": "5"
            }
          ],
          "questionOptions": [
            "Identifying gaps in academic research",
            "Standardizing terminology in reports",
            "Structuring a forensic tool's capabilities",
            "Improving tool interpretability",
            "Onboarding/Training new digital forensics analysts"
          ]
        }
      ]
    },
    "thank-you": {
