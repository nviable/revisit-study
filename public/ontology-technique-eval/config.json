{
  "$schema": "https://raw.githubusercontent.com/revisit-studies/study/v2.4.3/src/parser/StudyConfigSchema.json",
  "studyMetadata": {
    "title": "Ontology-supported descriptions of digital media forensic techniques",
    "version": "1.0",
    "authors": [
      "Y. Kelly Wu",
      "Saniat J. Sohrawardi",
      "Matthew Wright",
      "Ersin Uzun"
    ],
    "date": "2026-08-20",
    "description": "A Prolific survey comparing keyword-supported and ontology-supported descriptions of digital media forensic techniques.",
    "organizations": [
      "Rochester Institute of Technology",
      "ESL Global Cybersecurity Institute"
    ]
  },
  "uiConfig": {
    "contactEmail": "kellywu@mail.rit.edu",
    "helpTextPath": "ontology-technique-eval/assets/help.md",
    "logoPath": "revisitAssets/icon-defake.svg",
    "withProgressBar": true,
    "withSidebar": true,
    "sidebarWidth": 360,
    "enumerateQuestions": true,
    "responseDividers": true,
    "urlParticipantIdParam": "PROLIFIC_PID",
    "stylesheetPath": "ontology-technique-eval/assets/style.css",
    "numSequences": 200
  },
  "studyRules": {
    "devices": {
      "allowed": [
        "desktop",
        "tablet"
      ],
      "blockedMessage": "Please complete this study on a laptop or desktop computer so the technique cards remain readable."
    },
    "display": {
      "minWidth": 900,
      "minHeight": 600,
      "blockedMessage": "Please widen your browser window so the scenario and technique cards are fully visible."
    }
  },
  "baseComponents": {
    "taskATrial": {
      "type": "react-component",
      "path": "ontology-technique-eval/assets/TaskAStimulus.tsx",
      "nextButtonLocation": "sidebar",
      "previousButton": false,
      "response": [
        {
          "id": "sidebarGuidance",
          "prompt": "**Read the scenario and technique materials on the right first.** The questions below refer to that content.",
          "location": "sidebar",
          "type": "textOnly"
        },
        {
          "id": "applies",
          "prompt": "Could this technique be applied to produce useful evidence in this scenario?",
          "location": "sidebar",
          "type": "radio",
          "options": [
            "Yes, it applies",
            "No, it does not apply",
            "Not enough information to decide"
          ],
          "required": false
        },
        {
          "id": "confidence",
          "prompt": "How confident are you in this judgment?",
          "location": "sidebar",
          "type": "radio",
          "options": [
            {
              "label": "1 — Not at all confident",
              "value": "1"
            },
            {
              "label": "2 — Slightly confident",
              "value": "2"
            },
            {
              "label": "3 — Moderately confident",
              "value": "3"
            },
            {
              "label": "4 — Very confident",
              "value": "4"
            },
            {
              "label": "5 — Completely confident",
              "value": "5"
            }
          ],
          "required": false
        },
        {
          "id": "reliedOn",
          "prompt": "What did you rely on when deciding? Select all that apply.",
          "location": "sidebar",
          "type": "checkbox",
          "required": false,
          "withOther": true,
          "options": [
            "Technique title",
            "Keywords or ontology tags",
            "Ontology tag definitions",
            "AI summary",
            "Abstract",
            "Full paper"
          ]
        },
        {
          "id": "decisionNote",
          "prompt": "Anything else you'd like to add about this decision?",
          "location": "sidebar",
          "type": "longText",
          "placeholder": "Optional",
          "required": false
        },
        {
          "id": "clickLog",
          "prompt": "Card interaction events (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        },
        {
          "id": "elementDwellTimes",
          "prompt": "Time spent on opened elements, in milliseconds (recorded automatically)",
          "location": "sidebar",
          "type": "reactive",
          "hidden": true,
          "required": false
        },
        {
          "id": "openedElements",
          "prompt": "Opened elements (recorded automatically)",
