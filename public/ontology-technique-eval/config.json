      "type": "questionnaire",
      "description": "Template attention check between Task A items 4 and 5",
      "response": [
        {
          "id": "attentionA",
          "prompt": "Attention check: please select **Somewhat agree**. This item is only to confirm you are reading the questions.",
          "location": "aboveStimulus",
          "type": "radio",
          "options": [
            "Strongly disagree",
            "Disagree",
            "Somewhat disagree",
            "Somewhat agree",
            "Agree",
            "Strongly agree"
          ]
        }
      ]
    },
    "attention-check-b": {
      "type": "questionnaire",
      "description": "Template attention check between Task B items 2 and 3",
      "response": [
